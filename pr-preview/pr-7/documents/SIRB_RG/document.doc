  mso-pagination: widow-orphan;
  tab-stops: 19.85pt 39.7pt 59.55pt 79.4pt 99.25pt 119.05pt 138.9pt 158.75pt 178.6pt 7cm;
  font-size: 10.0pt;
  mso-bidi-font-size: 11.0pt;
  font-family: "Cambria",serif;
  mso-fareast-font-family: "SimSun", serif;
  mso-bidi-font-family: "Cambria",serif;
  mso-ansi-language: EN-GB;
}

.MsoChpDefault {
  mso-style-type: export-only;
  mso-default-props: yes;
  font-family: "Cambria",serif;
  font-size: 10pt;
  mso-bidi-font-size: 10pt;
  mso-ascii-font-family: "Cambria",serif;
  mso-fareast-font-family: "SimSun", serif;
  mso-hansi-font-family: "Cambria",serif;
}

p.TOCTitle, li.TOCTitle, div.TOCTitle {
  mso-style-name: "TOC Title";
  mso-style-unhide: no;
  margin-top: 0in;
  margin-right: 0in;
  margin-bottom: 11.0pt;
  margin-left: 0in;
  text-align: left;
  page-break-after: avoid;
  mso-pagination: none;
  mso-hyphenate: none;
  mso-layout-grid-align: none;
  font-size: 11.0pt;
  mso-bidi-font-size: 10pt;
  font-weight: bold;
  font-family: "Cambria",serif;
  mso-fareast-font-family: "Cambria",serif;
  mso-bidi-font-family: "Cambria",serif;
  mso-fareast-language: EN-US;
}

/* Page Definitions */
@page {
  mso-mirror-margins: yes;
  mso-page-border-surround-header: no;
  mso-page-border-surround-footer: no;
  mso-endnote-separator: url(cid:header.html) es;
  mso-endnote-continuation-separator: url(cid:header.html) ecs;
  mso-footnote-separator: url(cid:header.html) fs;
  mso-footnote-continuation-separator: url(cid:header.html) fcs;
  mso-facing-pages: yes;
}
